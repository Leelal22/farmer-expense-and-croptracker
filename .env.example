# Backend Environment Variables
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=super-secret-key-change-this-in-production
JWT_SECRET_KEY=jwt-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database Configuration
# Local SQLite for quick testing without Docker: sqlite:///farmer_tracker.db
# PostgreSQL Docker format: postgresql://postgres:postgres@postgres:5432/farmer_tracker
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/farmer_tracker
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# PostgreSQL Docker Environment
POSTGRES_DB=farmer_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Leela@123
POSTGRES_PORT=5432

# Frontend Environment Variables
VITE_API_URL=http://localhost:5000/api
